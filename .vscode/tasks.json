{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "qmake configure",
            "type": "shell",
            "command": "mkdir -p build-linux && cd build-linux && qmake6 ../ambiled_desktop.pro",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "make -j$(nproc)",
            "options": {
                "cwd": "${workspaceFolder}/build-linux"
            },
            "dependsOn": "qmake configure",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
